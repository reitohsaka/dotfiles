{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1
        },
        "color": {
			"1": "38;5;210",
			"2": "38;5;255"
		}
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "color": {
				"user": "38;5;210",
				"host": "38;5;210"
			}
        },
        {
            "type": "os",
            "key": "os    ",
            "keyColor": "38;5;210"
        },
        {
            "type": "kernel",
            "key": "kernel",
            "keyColor": "38;5;210"
        },
        {
            "type": "packages",
            "key": "pkgs  ",
            "keyColor": "38;5;210"
        },
        {
            "type": "command",
            "key": "age   ",
            "keyColor": "38;5;210",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "format": "{?days}{days}d {?}{hours}h {minutes}m",
            "key": "uptime",
            "keyColor": "38;5;210"
        },
        {
            "type": "memory",
            "key": "memory",
            "keyColor": "38;5;210"
        },
        "break"
    ]
}
